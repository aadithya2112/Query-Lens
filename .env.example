# Copy this file to `.env` at the repo root and fill in secrets.
# `.env` is gitignored — keep real keys only there (or in `.env.local` for Next.js overrides).
# See README.md → Environment variables.

# --- Local databases (Docker; see README) ---
POSTGRES_URL=postgresql://querylens:querylens@localhost:5432/querylens
MONGODB_URL=mongodb://localhost:27017/querylens

# --- Gemini (required for interactive /api/query planning and narratives) ---
GEMINI_API_KEY=
# Optional override; default is gemini-2.5-flash
# QUERYLENS_GEMINI_MODEL=gemini-2.5-flash

# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex (https://dashboard.convex.dev or `npx convex dev`) ---
# The app reads this at build/runtime; `npx convex dev` often writes it to `.env.local`.
NEXT_PUBLIC_CONVEX_URL=

# --- Convex deployment only (Clerk JWT issuer for convex/auth.config.ts) ---
# Set on your Convex project, not necessarily in Next.js env, e.g.:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN "https://YOUR-SUBDOMAIN.clerk.accounts.dev"
# Docs: https://docs.convex.dev/auth/clerk
